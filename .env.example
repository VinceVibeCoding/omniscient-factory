# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
SLACK_BOT_TOKEN=        # xoxb-...  (Bot User OAuth Token)
SLACK_APP_TOKEN=        # xapp-...  (App-level token with connections:write, for Socket Mode)
SLACK_CHANNEL_ID=       # channel for digests, e.g. C0123456789
GITHUB_TOKEN=           # optional; raises GitHub API rate limits (read-only public scope is enough)
SLACK_OWNER_ID=         # your Slack member ID (profile > ... > Copy member ID); only you can resolve grilling tickets
